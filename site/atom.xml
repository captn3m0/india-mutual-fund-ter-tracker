---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="{{ site.lang }}">
  <title>{{ site.title | xml_escape }}</title>
  <subtitle>{{ site.description | xml_escape }}</subtitle>
  <link href="{{ page.url | absolute_url }}" rel="self" type="application/atom+xml"/>
  <link href="{{ '/' | absolute_url }}" rel="alternate" type="text/html"/>
  <id>{{ page.url | absolute_url }}</id>
  <author><name>{{ site.author | xml_escape }}</name></author>
  {%- assign latest = site.data.changes | first %}
  <updated>{% if latest %}{{ latest.date | date_to_xmlschema }}{% else %}{{ site.time | date_to_xmlschema }}{% endif %}</updated>
  {%- for entry in site.data.changes limit: site.feed_limit %}
  <entry>
    {%- capture title %}{% include title.html entry=entry %}{% endcapture %}
    {%- capture body %}{% include changes.html entry=entry %}{% endcapture %}
    <title>{{ title | xml_escape }}</title>
    <link href="{{ entry.url }}" rel="alternate" type="text/html"/>
    <id>urn:sha1:{{ entry.id }}</id>
    <updated>{{ entry.date | date_to_xmlschema }}</updated>
    <content type="html">{{ body | xml_escape }}</content>
  </entry>
  {%- endfor %}
</feed>
